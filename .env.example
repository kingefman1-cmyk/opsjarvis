# OpsJarvis runs on built-in demo data with NO keys. Copy this file to .env.local to wire real services.
# Everything here is read server-side only (app/api/*, scripts/*) and is never sent to the browser.

# --- LLM engine: Claude is primary; automatic failover to Gemini, then Groq, if a key is missing or a provider fails ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Telegram demo bot (scripts/tg-demo-bot.ts): token from @BotFather ---
TELEGRAM_BOT_TOKEN=

# --- Links shown in the bot and dashboard ---
DEMO_URL=https://opsjarvis.vercel.app
HIRE_URL=https://www.fiverr.com/king12fx/build-your-custom-claude-ai-assistant-and-automated-dashboard

# --- Connectors (production builds; not wired in open-core) ---
SLACK_BOT_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
STRIPE_SECRET_KEY=
HUBSPOT_ACCESS_TOKEN=

# --- Blueprint lead capture (app/api/leads/blueprint) ---
# Resend (resend.com, free tier). Without it the blueprint still renders on screen; the email step is skipped.
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Where hot-lead alerts go (your own chat id with the bot). Leave blank to disable alerts.
TELEGRAM_CHAT_ID=
